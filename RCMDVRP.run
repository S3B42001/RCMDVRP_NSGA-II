reset;

model RCMDVRP.mod;
data Instance11.dat;

option solver "gurobi";
option gurobi_options 'timelim = 3600';
# option gurobi_options 'timelim = 300';
option show_stats 1;
option solver_msg 1;

printf "\n=========== FASE 1: Mejor valor por objetivo ===========\n";

for {i in objetivos} {
    let g := i;
    solve FO1;
    let MV[i] := F[i];
    printf "MV[%d] (Mejor valor para obj %d): %f\n", i, i, MV[i];
}

let g := 0;


### NUEVO: guardar MV[i] en archivo
printf "# Mejores valores por objetivo\n" > "mejores_valores.txt";
for {i in objetivos} {
    printf "MV[%d] = %f\n", i, MV[i] > "mejores_valores.txt";
}


# Inicializar peores valores con los mismos MV
for {i in objetivos} {
    let PV[i] := MV[i];
}

# Matriz para almacenar el frente
param FronteraPareto{ejecuciones, objetivos} default 0;

printf "\n=========== FASE 2: Frontera de Pareto (normalizada) ===========\n";

for {ejec in ejecuciones} {
    printf "\n>> EJECUCION %d\n", ejec;

    for {i in objetivos} {
        let betha[i] := sigma[ejec,i];
        printf "sigma[%d,%d] = %f\n", ejec, i, sigma[ejec,i];
    }

    solve FO2;

    if MV[1] == 0 || MV[2] == 0 then {
        printf "\n** El modelo es INVIABLE. No se puede generar la frontera de Pareto. **\n";
        exit 0;
    }

    printf "F_objetivos: ";
    for {i in objetivos} {
        printf "F[%d]=%f ", i, F[i];
        let FronteraPareto[ejec, i] := F[i];
        if F[i] > PV[i] then {
            let PV[i] := F[i];
        }
    }
    printf "\n";

    printf "Valor objetivo combinado (FO2): %f\n", FO2;

    printf "\n==== EJECUCION %d ====\n", ejec > "resultados.txt";
    printf "FO2 = %f\n", FO2 > "resultados.txt";
    for {i in objetivos} {
        printf "F[%d] = %f \n", i, F[i] > "resultados.txt";
    }

    printf "\n--- Rutas seleccionadas (x[i,j,k] = 1) ---\n" > "resultados.txt";
    for {i in N, j in N, k in K: (i,j) in A and x[i,j,k] > 0.9} {
        printf "Vehiculo %s: %s -> %s\n", k, i, j > "resultados.txt";
    }

    printf "\n--- Clientes atendidos por cada vehículo (y[i,k] = 1) ---\n" > "resultados.txt";
    for {i in R, k in K: y[i,k] > 0.9} {
        printf "Cliente %s atendido por Vehiculo %s\n", i, k > "resultados.txt";
    }

    printf "---------------------------------------------\n\n" > "resultados.txt";
}

# ---------------------- MOSTRAR FRENTE DE PARETO FINAL ----------------------
printf "\n=========== FRENTE DE PARETO FINAL ===========\n";
for {ejec in ejecuciones} {
    if FronteraPareto[ejec,1] != 0 || FronteraPareto[ejec,2] != 0 then {
        printf "Punto %d: ", ejec;
        for {i in objetivos} {
            printf "F[%d] = %f ", i, FronteraPareto[ejec,i];
        }
        printf "\n";
    }
}

# Guardar el frente a archivo externo
printf "\n# Frontera de Pareto\n" > "frontera_pareto.txt";
for {ejec in ejecuciones} {
    if FronteraPareto[ejec,1] != 0 || FronteraPareto[ejec,2] != 0 then {
        for {i in objetivos} {
            printf "%f ", FronteraPareto[ejec,i] > "frontera_pareto.txt";
        }
        printf "\n" > "frontera_pareto.txt";
    }
}

# Mostrar peores valores
printf "\n>>> PV = {";
for {i in objetivos} {
    printf "%f ", PV[i];
}
printf "}\n";

printf "\n=========== FIN DE EJECUCIONES ===========\n";
